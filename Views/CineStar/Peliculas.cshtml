@model List<webCinestart_MVC.Models.Pelicula>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />
<h1>@ViewBag.Titulo</h1>
<br />

@foreach (var pelicula in Model)
{
    <div class="contenido-pelicula">
        <div class="datos-pelicula">
            <h2>@pelicula.Titulo</h2><br />
            <p>@pelicula.Sinopsis</p>
            <br />
            <div class="boton-pelicula">
                <a href="@Url.Action("Pelicula", "CineStar", new { id = pelicula.id })">
                    <img src="~/Contents/img/varios/btn-mas-info.jpg" width="120" height="30" alt="Ver info" />
                </a>
            </div>
            <div class="boton-pelicula">
                <a href="https://www.youtube.com/v/@(pelicula.Link)" target="_blank" onclick="return hs.htmlExpand(this, { objectType: 'iframe' } )">
                    <img src="~/Contents/img/varios/btn-trailer.jpg" width="120" height="30" alt="Ver trailer" />
                </a>
            </div>
        </div>
        <img src="~/Contents/img/pelicula/@(pelicula.id).jpg" width="160" height="226" /><br /><br />
    </div>
}